{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "bpch/gallery-filter",
  "version": "0.1.0",
  "title": "Gallery filter",
  "category": "design",
  "icon": "images-alt2",
