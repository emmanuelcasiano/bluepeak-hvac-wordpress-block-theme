<?xml version="1.0"?>
<ruleset name="Blue Peak Climate Theme">
	<description>WordPress Coding Standards for the Blue Peak Climate theme. Run with the plugin's PHPCS: ../../plugins/blue-peak-climate-core/vendor/bin/phpcs</description>

	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<!-- Keep code runnable on PHP 7.4 (WordPress minimum) and WP 6.8+. -->
	<config name="testVersion" value="7.4-"/>
	<config name="minimum_wp_version" value="6.8"/>

	<rule ref="WordPress"/>
	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="blue-peak-climate"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="bpch"/>
			</property>
		</properties>
	</rule>
</ruleset>
